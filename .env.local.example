# Copy to .env.local (never commit .env.local). Read by the API at startup.
# Supabase -> Project Settings -> API
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=YOUR-ANON-OR-PUBLISHABLE-KEY
# The account with this email becomes the first administrator ONLY after it verifies the email
# through Supabase, and only if no administrator exists yet.
INITIAL_ADMIN_EMAIL=halaaleanzi76@gmail.com
